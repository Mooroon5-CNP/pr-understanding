# Copy to .env.local for local development. Configure the same values in Vercel.
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# GitHub OAuth App: callback = APP_URL/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App: contents/PR read, checks write; pull_request webhooks
GITHUB_APP_ID=
# PEM private key. Use escaped newlines (\n) in a quoted environment value.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=

# Exact owner/repo names. Add another name to enable a new repository.
ALLOWED_REPOSITORIES=Mooroon5-CNP/app-2-dancingDuck,Mooroon5-CNP/app4-pixelcalm,Mooroon5-CNP/cnp-test-node,Mooroon5-CNP/cnp-portal,Mooroon5-CNP/exemple-app-cnp,Mooroon5-CNP/ci-templates,Mooroon5-CNP/app3-clown-samba,Mooroon5-CNP/last-test
# Optional explicit organization-wide opt-in, including future repositories.
# Keep empty to use only the exact repository list above.
ALLOWED_ORGANIZATIONS=

# Neon PostgreSQL connection string, including sslmode=require.
DATABASE_URL=

# OpenAI-compatible chat completions endpoint. Supply your own API key/model.
GENERATIVE_API_BASE_URL=https://api.openai.com/v1
GENERATIVE_API_KEY=
GENERATIVE_MODEL=
